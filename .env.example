# .env 템플릿. 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 저장소에 올리지 않는다.

# 키움 REST API (openapi.kiwoom.com > 계좌 App Key 관리)
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_BASE_URL=https://api.kiwoom.com

# Finnhub (finnhub.io)
FINNHUB_API_KEY=

# 구글 Apps Script 웹앱 URL과 동기화 암호(스크립트 속성 SYNC_TOKEN과 같은 값)
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# 미리보기 조회 기간(일)
LOOKAHEAD_DAYS=90

# OpenDART (opendart.fss.or.kr)
OPENDART_API_KEY=

# 실적 일정을 만들 국내 관심그룹 이름(영웅문 그룹명과 똑같이)
KR_WATCHLIST_GROUP=
